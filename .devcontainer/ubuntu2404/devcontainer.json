{
    "name": "Ubuntu 24.04",
    "build": {
        "context": "../../",
        "dockerfile": "Dockerfile"
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "Dart-Code.dart-code",
                "Dart-Code.flutter"
            ]
        }
    },
    "postCreateCommand": "fvm use $(jq -r '.flutter' .fvmrc)"
}